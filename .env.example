# Portfolio CMS - Environment Configuration Example

# Server Configuration
PORT=3000
NODE_ENV=production
# In production on Render: https://portfolio-cms-kmcy.onrender.com
# In local development: http://localhost:3000
FRONTEND_URL=https://portfolio-cms-kmcy.onrender.com
CORS_ORIGIN=https://portfolio-cms-kmcy.onrender.com

# Database Configuration (PostgreSQL through Supabase)
# NOTE: Do NOT enclose in quotation marks when entering in Render Environment Variables.
# Direct Connection format:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
# Connection Pooling format (Recommended for Serverless / Cloud hosts):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=

# Supabase Credentials & Storage
# SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-media

# JWT Authentication (32+ character distinct secrets)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gemini AI API Key (AI Studio runtime)
GEMINI_API_KEY=

# Email / Contact Notifications (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# App Hosting URL
APP_URL=https://portfolio-cms-kmcy.onrender.com

# Frontend Configuration
VITE_API_BASE_URL=
