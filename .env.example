# Portfolio CMS - Environment Configuration Example

# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Configuration (PostgreSQL through Supabase)
DATABASE_URL=

# Supabase Credentials & Storage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=portfolio-media

# JWT Authentication
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Gemini AI API Key (AI Studio runtime)
GEMINI_API_KEY=

# Email / Contact Notifications (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_EMAIL_TO=
CONTACT_EMAIL_FROM=

# App Hosting URL (AI Studio runtime)
APP_URL=

# Frontend Configuration
VITE_API_BASE_URL=
